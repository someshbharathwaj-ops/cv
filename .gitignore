# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Distribution / packaging
build/
dist/
*.egg-info/

# Virtual environments
.env
.venv
env/
venv/

# IDE and Editor configs
.vscode/
.idea/
*.swp
*.swo

# Temporary and backup files
*.bak
0

# Large model weights / checkpoints (exceeds GitHub 100MB file limit)
*.pth
*.pt
*.ckpt
*.bin

# Data directories (raw training/test images and preprocessed caches)
data/nnUNet_preprocessed/
data/pretrained/

# Exclude raw dataset images and volume files, while preserving dataset.json
data/nnUNet_raw/**/imagesTr/
data/nnUNet_raw/**/imagesTs/
data/nnUNet_raw/**/imagesVal/
data/nnUNet_raw/**/labelsTr/
data/nnUNet_raw/**/labelsTs/
data/nnUNet_raw/**/labelsVal/
data/nnUNet_raw/**/labelsTr-instance-mask/
data/nnUNet_raw/**/labelsVal-instance-mask/
data/nnUNet_raw/**/*.png
data/nnUNet_raw/**/*.tiff
data/nnUNet_raw/**/*.tif
data/nnUNet_raw/**/*.nii.gz
